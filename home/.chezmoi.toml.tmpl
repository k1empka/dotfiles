{{- $name := promptStringOnce . "name" "Your full name" -}}
{{- $email := promptStringOnce . "email" "Your email address" -}}
{{- $theme := promptChoiceOnce . "theme" "Choose theme" (list "rose-pine" "catppuccin" "tokyo-night") -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    theme = {{ $theme | quote }}
