{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "foreground": "#e0def4",
          "background": "#31748f",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "template": " {{ .Icon }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#e0def4",
          "background": "#c4a7e7",
          "properties": {
            "style": "full",
            "folder_separator_icon": " \ue0b1 "
          },
          "template": " \uf07c {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#191724",
          "background": "#ebbcba",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#f6c177{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#eb6f92{{ end }}",
            "{{ if gt .Ahead 0 }}#9ccfd8{{ end }}",
            "{{ if gt .Behind 0 }}#9ccfd8{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_max_length": 25
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ .BranchStatus }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#e0def4",
          "background": "#31748f",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          },
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} "
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#191724",
          "background": "#9ccfd8",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          },
          "template": " \ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#191724",
          "background": "#f6c177",
          "properties": {
            "fetch_version": true,
            "display_mode": "files",
            "fetch_virtual_env": true
          },
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#e0def4",
          "background": "#6e6a86",
          "properties": {
            "threshold": 500,
            "style": "austin",
            "always_enabled": false
          },
          "template": " \ueba2 {{ .FormattedMs }} "
        },
        {
          "type": "status",
          "style": "diamond",
          "foreground": "#e0def4",
          "background": "#31748f",
          "background_templates": [
            "{{ if gt .Code 0 }}#eb6f92{{ end }}"
          ],
          "trailing_diamond": "\ue0b4",
          "properties": {
            "always_enabled": true
          },
          "template": " {{ if gt .Code 0 }}\uf00d {{ .Code }}{{ else }}\uf00c{{ end }} "
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "time",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b4",
          "foreground": "#e0def4",
          "background": "#908caa",
          "template": " \uf017 {{ .CurrentDate | date .Format }} "
        }
      ]
    }
  ]
}
