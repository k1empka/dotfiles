import = ["~/.config/alacritty/themes/{{ .theme }}.toml"]

[font]
size = 14

[font.normal]
family = "JetBrainsMono Nerd Font"
style = "Regular"

[font.bold]
family = "JetBrainsMono Nerd Font"
style = "Bold"

[font.italic]
family = "JetBrainsMono Nerd Font"
style = "Italic"

[window]
padding = { x = 8, y = 8 }
dynamic_padding = true
opacity = 0.95

{{ if eq .chezmoi.os "darwin" -}}
[window.decorations]
option_as_alt = "Both"
{{ end -}}

[scrolling]
history = 10000

[cursor.style]
shape = "Block"
blinking = "On"
